---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="About the Founder">
	<section class="section">
		<span class="about-badge">Leadership Profile</span>
		<h1 class="page-title">About the Founder</h1>
		<p class="subtitle">Business Leader, Venture Builder & Innovation Strategist empowering enterprises to scale and cultivating visionary leaders.</p>

		<div class="about-layout-detail">
			<div class="bio-text">
				<h2>The Vision & Leadership Journey</h2>
				<p>I am a business leader, venture builder, and innovation strategist dedicated to enlightening businesses and developing the next generation of visionary leaders. My mission is simple yet transformative: to bridge deep strategic insight with technology innovation, empowering enterprises to achieve rapid, resilient, and sustainable market growth.</p>
				
				<p>Throughout my career leading complex, high-stakes technology initiatives, I discovered that true commercial breakthrough comes from the convergence of two forces: <strong>visionary personal leadership</strong> and <strong>adaptive organizational architecture</strong>. Too many companies stumble not from a lack of technical ambition, but from organizational friction, misaligned execution, and leadership blind spots.</p>
				
				<p>Through <strong>Dream & Dare</strong>, I partner with founders, executives, and scaling enterprises to eliminate these bottlenecks. We develop bespoke executive masterclasses, high-impact organizational frameworks, and proprietary predictive simulation tools like <strong>Business Minecraft</strong>—enabling leaders to stress-test strategic decisions, optimize capital efficiency, and steer their companies toward market dominance.</p>

				<p>Whether mentoring future executives or architecting new digital venture models, my focus is unwavering: turning ambitious visions into scalable, highly profitable, and enduring businesses.</p>
			</div>
			
			<div class="bio-competencies">
				<h3>Executive Core Competencies</h3>
				
				<div class="comp-card">
					<h4>Business Growth & Venture Scaling</h4>
					<p>Designing repeatable commercial engines, high-margin revenue architectures, and scalable organizational frameworks that propel enterprises from initial traction to market leadership.</p>
				</div>
				
				<div class="comp-card">
					<h4>Executive Leadership & Org Design</h4>
					<p>Mentoring founders and executive teams to build high-trust cultures, accelerate decision velocity, and implement adaptive Ways of Working (WoW) tailored for rapid scale.</p>
				</div>
				
				<div class="comp-card">
					<h4>Breakthrough Technology Innovation</h4>
					<p>Harnessing AI reasoning engines, enterprise simulation sandboxes, and modern software architectures to solve industry bottlenecks and create unfair competitive moats.</p>
				</div>
			</div>
		</div>

		<!-- Contact Section -->
		<div class="contact-section-wrapper">
			<h2>Get in Touch</h2>
			<p>Collaborate on system designs, request specialized training briefs, or license operational software.</p>
			
			<form class="contact-form" id="about-contact-form">
				<div class="form-row">
					<div class="form-group">
						<label for="name">Your Name</label>
						<input type="text" id="name" name="name" placeholder="John Doe" required />
					</div>
					<div class="form-group">
						<label for="email">Email Address</label>
						<input type="email" id="email" name="email" placeholder="john@example.com" required />
					</div>
				</div>
				
				<div class="form-group">
					<label for="subject">Subject</label>
					<input type="text" id="subject" name="subject" placeholder="Collaboration Request" required />
				</div>
				
				<div class="form-group">
					<label for="message">Message</label>
					<textarea id="message" name="message" rows="6" placeholder="Describe your project details..." required></textarea>
				</div>
				
				<button type="submit" class="btn btn-primary">Send Message</button>
			</form>
		</div>
	</section>

	<!-- Contact Form Script to open Email Client -->
	<script is:inline>
		const form = document.getElementById('about-contact-form');
		if (form) {
			form.addEventListener('submit', (e) => {
				e.preventDefault();
				const name = document.getElementById('name').value;
				const email = document.getElementById('email').value;
				const subject = document.getElementById('subject').value;
				const message = document.getElementById('message').value;

				const mailtoEmail = 'blackfireagent@gmail.com';
				const mailtoSubject = encodeURIComponent(`[Dream & Dare] ${subject}`);
				const mailtoBody = encodeURIComponent(
					`Name: ${name}\n` +
					`Email: ${email}\n\n` +
					`Message:\n${message}`
				);

				window.location.href = `mailto:${mailtoEmail}?subject=${mailtoSubject}&body=${mailtoBody}`;
			});
		}
	</script>
</Layout>

<style>
	.about-badge {
		display: inline-block;
		background: rgba(99, 102, 241, 0.08);
		border: 1px solid rgba(99, 102, 241, 0.15);
		color: var(--color-dream);
		padding: 0.35rem 1rem;
		border-radius: 9999px;
		font-size: 0.85rem;
		font-weight: 600;
		margin-bottom: 1.5rem;
		letter-spacing: 0.5px;
		text-transform: uppercase;
	}

	.page-title {
		font-family: 'Outfit', sans-serif;
		font-size: 3rem;
		font-weight: 800;
		line-height: 1.15;
		margin-bottom: 1rem;
		letter-spacing: -0.5px;
	}

	.subtitle {
		font-size: 1.15rem;
		color: var(--text-secondary);
		max-width: 700px;
		margin-bottom: 4rem;
		font-weight: 300;
	}

	.about-layout-detail {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 4rem;
		margin-bottom: 5rem;
		align-items: start;
	}

	.bio-text h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.75rem;
		font-weight: 700;
		margin-bottom: 1.5rem;
	}

	.bio-text p {
		font-size: 1.05rem;
		color: var(--text-secondary);
		margin-bottom: 1.5rem;
		font-weight: 300;
		line-height: 1.75;
	}

	.bio-competencies h3 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 2rem;
	}

	.comp-card {
		background: var(--bg-surface);
		backdrop-filter: var(--glass-blur);
		border: 1px solid var(--border-color);
		border-radius: 12px;
		padding: 1.5rem;
		margin-bottom: 1.5rem;
		transition: all 0.3s ease;
	}

	.comp-card:hover {
		border-color: var(--border-hover);
		transform: translateX(4px);
	}

	.comp-card h4 {
		font-family: 'Outfit', sans-serif;
		font-size: 1.15rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		color: var(--color-dream);
	}

	.comp-card p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		font-weight: 300;
		line-height: 1.5;
	}

	/* Contact Form */
	.contact-section-wrapper {
		border-top: 1px solid var(--border-color);
		padding-top: 4rem;
		max-width: 800px;
		margin: 0 auto;
	}

	.contact-section-wrapper h2 {
		font-family: 'Outfit', sans-serif;
		font-size: 2rem;
		font-weight: 700;
		text-align: center;
		margin-bottom: 0.5rem;
	}

	.contact-section-wrapper p {
		font-size: 1rem;
		color: var(--text-secondary);
		text-align: center;
		margin-bottom: 3rem;
		font-weight: 300;
	}

	.contact-form {
		background: var(--bg-surface);
		backdrop-filter: var(--glass-blur);
		border: 1px solid var(--border-color);
		padding: 3rem;
		border-radius: 20px;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.01);
	}

	.form-row {
		display: flex;
		gap: 1.5rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		flex: 1;
	}

	.form-group label {
		font-size: 0.85rem;
		font-weight: 600;
		color: var(--text-primary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
	}

	.form-group input, .form-group textarea {
		background: rgba(255, 255, 255, 0.7);
		border: 1px solid var(--border-color);
		border-radius: 8px;
		padding: 0.8rem 1rem;
		color: var(--text-primary);
		font-family: inherit;
		outline: none;
		transition: border-color 0.3s;
		width: 100%;
	}

	.form-group input:focus, .form-group textarea:focus {
		border-color: var(--color-dream);
	}

	@media (max-width: 768px) {
		.page-title {
			font-size: 2.25rem;
		}
		.subtitle {
			font-size: 1.05rem;
			margin-bottom: 2.5rem;
		}
		.about-layout-detail {
			grid-template-columns: 1fr;
			gap: 3rem;
		}
		.form-row {
			flex-direction: column;
			gap: 1.5rem;
		}
		.contact-form {
			padding: 2rem;
		}
		.bio-text h2 {
			font-size: 1.75rem;
		}
	}

	@media (max-width: 480px) {
		.contact-form {
			padding: 1.5rem;
		}
		.contact-section-wrapper h2 {
			font-size: 1.5rem;
		}
		.contact-section-wrapper p {
			margin-bottom: 2rem;
		}
	}
</style>
